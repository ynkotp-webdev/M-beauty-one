---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PriceSection from '../components/PriceSection.astro';
import { salon, uah } from '../data/salon';
import { sections } from '../data/prices';
import face from '../assets/p-face.jpg';
import hair from '../assets/p-hair.jpg';
import nails from '../assets/p-nails.jpg';

const by = (id: string) => sections.find((s) => s.id === id)!;
const rail = { widths: [240, 360, 540, 720], sizes: '(max-width: 900px) 46vw, 26vw', quality: 68 };
---

<Base
  title="Ціни салону краси у Львові: M Beauty One"
  description={`Повний прайс салону M Beauty One у Львові: макіяж, брови, вії, зачіски, стрижки, фарбування, догляд Hahonico і Davines, манікюр, педикюр, нарощення. Актуально на ${salon.pricesDate}.`}
>
  <section slot="first" class="phead on-espresso">
    <div class="wrap grid12">
      <h1 class="serif">Ціни салону краси у&nbsp;Львові</h1>
      <div class="meta">
        <p class="mute">Ціни з онлайн-запису M Beauty One, актуальні на {salon.pricesDate}. На всі послуги записуйтеся через bookon.</p>
        <a class="act act-lg" href={salon.booking} target="_blank" rel="noopener">Записатися онлайн</a>
      </div>
      <nav class="jump" aria-label="Розділи прайсу">
        <ul>
          {sections.map((s) => (
            <li><a href={`#${s.id}`}><span class="serif">{s.title}</span><span class="small mute">від {uah(s.from)}</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- Три групи одного устрою: фото ліворуч їде за прокруткою, прайс праворуч -->
  <section class="grp face on-paper">
    <div class="wrap grid12">
      <aside class="rail">
        <figure>
          <Image src={face} alt="Макіяж смокі і довге гладке темне волосся, на тлі арочні дзеркала салону" {...rail} loading="eager" />
        </figure>
        <p>Макіяж, брови і вії роблять майстри салону та власниця Маріанна. У неї своя ціна, вона у правій колонці.</p>
      </aside>
      <div class="one">
        <PriceSection s={by('makiyazh')} open />
        <PriceSection s={by('brovy')} />
        <PriceSection s={by('viyi')} />
      </div>
    </div>
  </section>

  <section class="grp hairs on-espresso">
    <div class="wrap grid12">
      <aside class="rail">
        <figure>
          <Image src={hair} alt="Довге світле волосся з об'ємною укладкою на браш" {...rail} loading="lazy" />
          <figcaption class="credit">Укладка · Анна, макіяж · Таня</figcaption>
        </figure>
      </aside>
      <div class="c1"><PriceSection s={by('zachisky')} /></div>
      <div class="c2"><PriceSection s={by('stryzhky')} /><PriceSection s={by('dohlyad')} /></div>
      <div class="wide"><PriceSection s={by('farbuvannya')} /></div>
    </div>
  </section>

  <section class="grp nails on-paper">
    <div class="wrap grid12">
      <aside class="rail">
        <figure><Image src={nails} alt="Червоний манікюр, руки тримають бордову сумку" {...rail} loading="lazy" /></figure>
      </aside>
      <div class="c1"><PriceSection s={by('manikyur')} /></div>
      <div class="c2">
        <PriceSection s={by('pedykyur')} />
        <PriceSection s={by('naroshchennya')} />
      </div>
    </div>
  </section>

  <script is:inline>
    // На широкому екрані розділи відкриті всі. На телефоні відкриваємо той, на який прийшли за якорем.
    (() => {
      const all = [...document.querySelectorAll('details.price')];
      const sync = () => {
        if (matchMedia('(min-width: 900px)').matches) all.forEach((d) => (d.open = true));
        const t = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (t && t.matches('details')) { t.open = true; t.scrollIntoView(); }
      };
      sync();
      addEventListener('hashchange', sync);
    })();
  </script>
</Base>

<style>
  .phead { padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(3rem, 6vw, 5.5rem); }
  h1 { grid-column: 1 / span 7; font-size: var(--t-mega); line-height: 0.96; font-stretch: 66%; text-wrap: balance; }
  .meta { grid-column: 9 / span 4; align-self: end; display: grid; gap: 0.75rem; justify-items: start; }
  .jump { grid-column: 1 / -1; margin-top: clamp(2.5rem, 5vw, 4.5rem); }
  .jump ul { display: flex; flex-wrap: wrap; gap: 0.25rem clamp(1.25rem, 2.6vw, 2.5rem); }
  .jump a { display: inline-flex; align-items: baseline; gap: 0.5rem; min-height: 2.75rem; }
  .jump .serif { font-size: var(--t-title); transition: color 0.25s var(--ease-out); }
  .jump a:hover .serif { color: var(--accent); }

  .grp { padding-block: clamp(3.5rem, 7vw, 7rem); }
  .grp :global(.price + .price) { margin-top: clamp(1.5rem, 4vw, 3.5rem); }

  /* Фото стоїть на місці, поки поруч гортається прайс групи */
  .rail { grid-column: 1 / span 3; grid-row: 1 / span 2; align-self: start; position: sticky; top: 1.5rem; display: grid; gap: 1.25rem; }
  .rail figure { margin-left: calc(var(--gut) * -1); }
  .rail :global(img) { aspect-ratio: 3 / 4; object-fit: cover; }
  .rail .credit { padding-left: var(--gut); }
  .rail p { max-width: 30ch; }

  .one { grid-column: 5 / span 8; }
  .c1 { grid-column: 5 / span 4; grid-row: 1; padding-right: clamp(0rem, 1.6vw, 1.75rem); }
  .c2 { grid-column: 9 / span 4; grid-row: 1; }
  .wide { grid-column: 5 / span 8; grid-row: 2; margin-top: clamp(2rem, 5vw, 4.5rem); }

  @media (max-width: 900px) {
    .phead { min-height: calc(100svh - 3.5rem); display: grid; border-bottom: 2.25rem solid var(--color-paper); }
    .phead .grid12 { align-content: space-between; }
    h1, .meta, .rail, .one, .c1, .c2, .wide { grid-column: 1 / -1; grid-row: auto; position: static; padding-right: 0; }
    .meta { margin-top: 1.5rem; }
    .face .rail { grid-template-columns: 46% 1fr; align-items: end; margin-bottom: 1.5rem; }
    .hairs .rail, .nails .rail { display: none; }
    .c2, .wide { margin-top: clamp(1.5rem, 4vw, 3.5rem); }
  }
</style>
