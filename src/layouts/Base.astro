---
import '../styles/global.css';
import serifLatin from '@fontsource-variable/noto-serif-display/files/noto-serif-display-latin-wdth-normal.woff2?url';
import serifCyr from '@fontsource-variable/noto-serif-display/files/noto-serif-display-cyrillic-wdth-normal.woff2?url';
import { salon, base } from '../data/salon';
import Mark from '../components/Mark.astro';
import Splash from '../components/Splash.astro';

interface Props { title: string; description: string; splash?: boolean; }
const { title, description, splash = false } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: `${base}/tsiny`, label: 'Послуги і ціни', short: 'Ціни' },
  { href: `${base}/vesillia`, label: 'Весілля та події', short: 'Весілля' },
];
const map = [
  { href: `${base}/`, label: 'Головна' },
  ...nav,
  { href: `${base}/#roboty`, label: 'Роботи' },
  { href: `${base}/#vidhuky`, label: 'Відгуки' },
];
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3a251e" />
    <!-- Прев'ю посилання в Telegram/Viber/Facebook. og.jpg: знімок обкладинки 1200×630 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={salon.name} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL(`${base}/og.jpg`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="M Beauty One, салон краси в центрі Львова" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/logo-mark.png`} />
    <link rel="preload" as="font" type="font/woff2" href={serifLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={serifCyr} crossorigin />
    {splash && (
      <script is:inline>
        // Заставка: раз за сесію, ?intro=1 показує знову, ?intro=0 вимикає. Клас стоїть до першої відмальовки.
        try {
          var f = /[?&]intro=1/.test(location.search);
          if (!/[?&]intro=0/.test(location.search) && (f || !sessionStorage.getItem('mbo-intro')) && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
            document.documentElement.classList.add('intro');
            sessionStorage.setItem('mbo-intro', '1');
          }
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    {splash && <Splash />}
    <a class="skip" href="#main">До змісту</a>
    <header class="top on-espresso">
      <a class="brand" href={`${base}/`} aria-label="M Beauty One, головна">
        <span class="mark" aria-hidden="true"><Mark /></span>
        <span class="addr">{salon.city}, {salon.address}</span>
      </a>
      <nav aria-label="Основна навігація">
        {nav.map((n) => (
          <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>
            <span class="lg">{n.label}</span><span class="sm">{n.short}</span>
          </a>
        ))}
        <a class="lg" href="#kontakty">Контакти</a>
      </nav>
      <a class="act" href={salon.booking} target="_blank" rel="noopener">Записатися</a>
    </header>

    <main id="main">
      <slot name="first" />
      <div class="rest">
        <slot />

        <footer class="foot on-ink" id="kontakty">
          <div class="wrap grid12 body">
            <div class="lead">
              <h2 class="serif h2">Запис і контакти</h2>
              <p class="how mute">На послуги салону записуйтеся онлайн, там видно вільний час кожного майстра. Весілля та події обговорюємо в Instagram Direct або телефоном.</p>
              <a class="act act-lg" href={salon.booking} target="_blank" rel="noopener">Записатися онлайн на bookon</a>
            </div>
            <div class="where">
              <address>
                {salon.city}, {salon.address}<br />
                <a class="link tap" href={salon.route} target="_blank" rel="noopener">Прокласти маршрут</a>
              </address>
              <dl class="hours">
                {salon.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.time}</dd></>))}
              </dl>
            </div>
            <ul class="ways">
              <li><a class="link tel" href={`tel:${salon.phone}`}>{salon.phoneText}</a></li>
              <li><a class="link" href={salon.instagram} target="_blank" rel="noopener">Instagram @m.beauty.one</a></li>
              <li><a class="link" href={salon.threads} target="_blank" rel="noopener">Threads @m.beauty.one</a></li>
            </ul>
            <nav class="map" aria-label="Розділи сайту">
              {map.map((n) => (
                <a class="link tap small" href={n.href} aria-current={(n.href.replace(/\/$/, '') || '/') === here ? 'page' : undefined}>{n.label}</a>
              ))}
            </nav>
            <p class="note small mute">Це концепт сайту від YonkaAgency, зроблений без замовлення салону. Фото й тексти належать M Beauty One та авторам знімків.</p>
          </div>
          <p class="mast serif" aria-hidden="true">M Beauty One</p>
        </footer>

        <nav class="dock on-ink" aria-label="Швидкий зв'язок">
          <a href={`tel:${salon.phone}`}>Дзвінок</a>
          <a href={salon.instagram} target="_blank" rel="noopener">Instagram</a>
          <a class="go" href={salon.booking} target="_blank" rel="noopener">Записатися</a>
        </nav>
      </div>
    </main>

    <script>
      // Курсор «кадрування». Крапка точно під мишею, кадр із міток обрізу м'яко її наздоганяє. На посиланні й кнопці
      // кадр обхоплює елемент (великі рядки прайсу лише стискають кадр), над каруселлю стає плашкою «тягни».
      // Колір бере поле під мишею: латунь на темному, еспресо на папері. Тільки миша
      const root = document.documentElement;
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const dot = document.createElement('div'), frame = document.createElement('div'), label = document.createElement('span');
        dot.className = 'cur-dot'; frame.className = 'cur-frame';
        dot.setAttribute('aria-hidden', 'true'); frame.setAttribute('aria-hidden', 'true');
        frame.append(label); document.body.append(frame, dot);
        root.classList.add('cur', 'cur-off');
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let x = 0, y = 0, raf = 0, tap: Element | null = null;
        const f = { x: 0, y: 0, w: 28, h: 28 };
        const goal = () => {
          const m = root.dataset.cur;
          if (m === 'link' && tap) {
            const r = tap.getBoundingClientRect(), cx = r.left + r.width / 2, cy = r.top + r.height / 2;
            return { x: cx + (x - cx) * 0.12, y: cy + (y - cy) * 0.12, w: r.width + 14, h: r.height + 10 };
          }
          if (m === 'drag') return { x, y, w: label.offsetWidth + 14, h: label.offsetHeight + 14 };
          const s = m === 'big' ? 16 : 28;
          return { x, y, w: s, h: s };
        };
        const tick = () => {
          const g = goal(), k = still ? 1 : 0.2;
          let d = 0;
          for (const key of ['x', 'y', 'w', 'h'] as const) { f[key] += (g[key] - f[key]) * k; d += Math.abs(g[key] - f[key]); }
          if (d < 0.3) Object.assign(f, g);
          frame.style.transform = `translate(${(f.x - f.w / 2).toFixed(1)}px, ${(f.y - f.h / 2).toFixed(1)}px)`;
          frame.style.width = `${f.w.toFixed(1)}px`; frame.style.height = `${f.h.toFixed(1)}px`;
          raf = d < 0.3 ? 0 : requestAnimationFrame(tick);
        };
        const pick = (t: Element | null) => {
          const orb = t?.closest('.orb');
          tap = t?.closest('a, button, summary, label') ?? null;
          let m = '';
          if (orb && !t!.closest('.nav')) {
            m = 'drag';
            label.textContent = !orb.hasAttribute('data-drag') && t!.closest('[data-front] button') ? 'звук' : '← тягни →';
          } else if (tap) {
            const r = tap.getBoundingClientRect();
            m = r.width > 360 || r.height > 120 ? 'big' : 'link';
          }
          if ((root.dataset.cur ?? '') !== m) root.dataset.cur = m;
          const tone = t?.closest('.on-paper, .on-espresso, .on-ink')?.classList.contains('on-paper') ? 'paper' : '';
          if ((root.dataset.curTone ?? '') !== tone) root.dataset.curTone = tone;
          if (!raf) raf = requestAnimationFrame(tick);
        };
        addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          x = e.clientX; y = e.clientY;
          if (root.classList.contains('cur-off')) { f.x = x; f.y = y; root.classList.remove('cur-off'); }
          dot.style.transform = `translate(${x}px, ${y}px)`;
          pick(e.target as Element);
        }, { passive: true });
        // колесо крутить сторінку під нерухомою мишею: pointermove не приходить, тож елемент під нею шукаємо самі
        addEventListener('scroll', () => { if (!root.classList.contains('cur-off')) pick(document.elementFromPoint(x, y)); }, { passive: true });
        addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') root.toggleAttribute('data-cur-press', true); else root.classList.add('cur-off'); });
        addEventListener('pointerup', () => root.removeAttribute('data-cur-press'));
        root.addEventListener('mouseleave', () => root.classList.add('cur-off'));
      }
    </script>
  <!-- impeccable-live-start -->
<script is:inline src="http://localhost:8400/live.js?token=68386183-83fa-4434-a254-cea911b80231"></script>
<!-- impeccable-live-end -->
</body>
</html>

<style>
  .skip { position: absolute; left: var(--gut); top: -4rem; z-index: 50; padding: 0.75rem 1rem; background: var(--color-paper); color: var(--color-espresso); }
  .skip:focus { top: 0.5rem; }

  .top { display: flex; align-items: center; gap: clamp(1rem, 2.4vw, 2.25rem); min-height: 4rem; padding-inline: var(--gut); font-size: var(--t-small); }
  .brand { display: flex; align-items: center; gap: 0.75rem; margin-right: auto; min-height: 2.75rem; color: var(--mute); }
  /* той самий SVG, що в заставці: вона садить знак точно в цю рамку. Розмір як у колишньої PNG-маски */
  .mark { width: 1.79rem; aspect-ratio: 550 / 565.5; color: var(--color-paper); }
  .mark :global(svg) { display: block; width: 100%; height: 100%; }
  .top nav { display: flex; gap: clamp(1rem, 2.4vw, 2.25rem); }
  .top nav a { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.45em; transition: text-decoration-color 0.2s; }
  .top nav a:hover, .top nav a[aria-current] { text-decoration-color: var(--accent); }
  .sm { display: none; }
  @media (max-width: 760px) {
    .addr, .lg, .top nav a.lg { display: none; }
    .top, .top nav { gap: clamp(0.6rem, 3.6vw, 1rem); }
    .sm { display: inline; }
    .top { min-height: 3.5rem; }
  }

  /* Нижня панель телефона: липне до низу, але тільки поки видно .rest, тобто після першого екрана */
  .rest { position: relative; }
  .dock { display: none; }
  @media (max-width: 760px) {
    .dock { position: sticky; bottom: 0; z-index: 20; display: grid; grid-template-columns: 1fr 1fr 1.25fr; border-top: 1px solid color-mix(in srgb, var(--color-paper) 16%, transparent); padding-bottom: env(safe-area-inset-bottom); }
    .dock a { display: grid; place-items: center; min-height: 3.25rem; font-size: var(--t-small); font-weight: 500; }
    .dock .go { background: var(--color-paper); color: var(--color-espresso); }
  }

  .foot { padding-top: clamp(4rem, 9vw, 8rem); overflow: clip; }
  .body { row-gap: 2.5rem; align-items: start; }
  .lead { grid-column: 1 / span 5; grid-row: 1; }
  .how { margin: 1.5rem 0 1rem; max-width: 44ch; }
  .where { grid-column: 7 / span 3; grid-row: 1; display: grid; gap: 1.5rem; }
  address { font-style: normal; font-size: var(--t-lead); }
  .hours { display: grid; grid-template-columns: max-content max-content; gap: 0.25rem 1.5rem; }
  .hours dt { color: var(--mute); }
  .hours dd { font-variant-numeric: tabular-nums lining-nums; }
  .ways { grid-column: 10 / span 3; grid-row: 1; display: grid; gap: 0.25rem; align-content: start; }
  .ways a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .tel { font-size: var(--t-lead); }
  .foot .mast { margin-top: 1rem; font-size: 16vw; text-transform: uppercase; text-align: center; white-space: nowrap; font-stretch: 62.5%; line-height: 1; height: 0.95em; color: var(--color-paper); }
  .note { grid-column: 1 / span 5; grid-row: 2; max-width: 60ch; }
  /* Розділи сайту: рядок дрібних посилань під адресою й контактами */
  .map { grid-column: 7 / -1; grid-row: 2; display: flex; flex-wrap: wrap; gap: 0 clamp(1rem, 2vw, 1.75rem); }
  .map [aria-current] { text-decoration-color: var(--accent); }
  @media (max-width: 900px) {
    .lead, .where, .ways, .map, .note { grid-column: 1 / -1; grid-row: auto; }
  }
</style>
